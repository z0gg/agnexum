---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION_EN } from '../../config';
---

<BaseLayout title="Privacy Policy" description={SITE_DESCRIPTION_EN} lang="en">
  <main class="bg-white py-28 dark:bg-[#071522]">
    <section class="container mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.25em] text-accent-600 dark:text-accent-300">Legal</p>
      <h1 class="mb-6 text-4xl font-extrabold text-slate-900 dark:text-white md:text-6xl">Privacy Policy</h1>
      <p class="mb-12 text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        This policy describes, in general terms, how AG Nexum Canada may collect, use and protect information submitted by website visitors.
      </p>

      <div class="glass-panel space-y-8 rounded-3xl p-6 leading-relaxed text-slate-600 dark:text-slate-400 sm:p-10">
        <section>
          <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-white">Information collected</h2>
          <p>We may collect information voluntarily provided through a contact form, including name, email address, request subject and message content.</p>
        </section>
        <section>
          <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-white">Use</h2>
          <p>This information is used to respond to inquiries, route visitors to the appropriate division, and provide the necessary administrative or commercial follow-up.</p>
        </section>
        <section>
          <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-white">Protection</h2>
          <p>AG Nexum Canada applies reasonable measures to protect received information from unauthorized access, use or disclosure.</p>
        </section>
        <section>
          <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-white">Sharing</h2>
          <p>Information may be shared with an internal division or professional partner only when necessary to process a request.</p>
        </section>
        <section>
          <h2 class="mb-3 text-2xl font-bold text-slate-900 dark:text-white">Contact</h2>
          <p>For any question about this policy, please contact AG Nexum Canada through the contact section of the website.</p>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>
