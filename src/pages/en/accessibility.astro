---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION_EN } from '../../config';
---

<BaseLayout title="Accessibility" description={SITE_DESCRIPTION_EN} lang="en">
  <main class="bg-slate-50 py-28 dark:bg-[#0c1118]">
    <article class="container mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="glass-panel rounded-3xl p-8 md:p-12">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.25em] text-primary-700 dark:text-accent-300">Accessibility</p>
        <h1 class="mb-6 text-4xl font-extrabold text-slate-900 dark:text-white md:text-5xl">Accessibility commitment</h1>
        <div class="space-y-6 leading-relaxed text-slate-600 dark:text-slate-400">
          <p>AG Nexum Canada aims to provide a clear, readable and usable website for as many visitors as possible.</p>
          <p>We prioritize readable contrast, structured navigation, alternative text for important images and an experience compatible with common assistive technologies.</p>
          <p>If you experience difficulty accessing information or a service, please contact us at <a href="mailto:info@agnexum.ca">info@agnexum.ca</a> so we can offer a reasonable solution.</p>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
