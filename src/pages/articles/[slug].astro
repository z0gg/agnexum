---
import ArticleDetail from '../../components/ArticleDetail.astro';
import { ARTICLES } from '../../data/articles';

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.locales.fr.slug },
    props: { article, content: article.locales.fr },
  }));
}

const { article, content } = Astro.props;
---

<ArticleDetail article={article} content={content} lang="fr" />
