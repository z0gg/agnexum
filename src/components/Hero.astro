---
import Button from './Button.astro';
---

<section id="hero" class="relative flex min-h-[92svh] items-center justify-center overflow-hidden bg-primary-950 px-4 py-32 text-center text-white sm:px-6 lg:min-h-screen lg:px-8">
  <picture class="absolute inset-0 -z-20">
    <source srcset="/images/hero/hero-montreal-office.webp" type="image/webp" />
    <img
      src="/images/hero/hero-montreal-office.webp"
      alt="Vue de bureau moderne à Montréal"
      class="h-full w-full object-cover"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(135deg,rgba(15,42,71,.88)_0%,rgba(26,58,82,.82)_52%,rgba(15,42,71,.9)_100%)]"></div>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_30%,rgba(201,169,97,.18),transparent_36%)]"></div>

  <div class="mx-auto max-w-5xl reveal-on-scroll">
    <p class="mb-6 text-sm font-bold uppercase tracking-[0.32em] text-accent-300 sm:text-base">
      Bienvenue
    </p>

    <h1 class="mb-6 text-5xl font-extrabold italic leading-[1.02] tracking-tight text-white drop-shadow-[0_3px_18px_rgba(0,0,0,.35)] sm:text-6xl md:text-7xl">
      AG NEXUM CANADA
    </h1>

    <p class="mx-auto mb-5 max-w-3xl text-xl font-semibold text-accent-200 drop-shadow sm:text-2xl">
      Executive Leadership Team
    </p>

    <p class="mx-auto mb-12 max-w-3xl text-lg leading-relaxed text-white/90 drop-shadow sm:text-2xl">
      Un cabinet canadien multidisciplinaire au service de la mobilité, du capital et de la performance.
    </p>

    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <Button href="#contact" variant="primary" size="lg" class="w-full border border-accent-300/50 bg-accent-500 px-8 py-4 text-lg text-primary-950 shadow-xl shadow-primary-950/30 hover:bg-accent-300 sm:w-auto">
        Consultation gratuite
      </Button>
      <Button href="#a-propos" variant="outline" size="lg" class="w-full border-white/50 bg-white/10 px-8 py-4 text-lg text-white shadow-xl shadow-primary-950/20 backdrop-blur-md hover:bg-white/20 sm:w-auto">
        En savoir plus
      </Button>
    </div>
  </div>
</section>
