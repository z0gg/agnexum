---
const reasons = [
  {
    title: 'Ancrage canadien',
    text: 'Siège social au Québec. Conformité au Registraire des entreprises. Standards canadiens en matière de service, de protection des renseignements personnels et d’éthique professionnelle.',
  },
  {
    title: 'Portée internationale',
    text: "Réseau d’agents structurés en Afrique francophone — Guinée, Côte d’Ivoire, Cameroun — et partenariats B2B en cours d’expansion sur les axes Europe et Amériques.",
  },
  {
    title: 'Conformité réglementaire',
    text: "Aucun conseil juridique en immigration n’est rendu hors du cadre CRCIC ou du Barreau canadien. Aucune vente de titre de transport en direct. Aucun frais avant succès en recouvrement.",
  },
  {
    title: 'Chaîne de valeur intégrée',
    text: 'Juridique, gestion de dossiers, services linguistiques, développement commercial. Une seule maison, plusieurs spécialités, un seul standard de qualité.',
  },
];

const network = [
  ['🇨🇮', "Côte d’Ivoire", 'Sous-traitance — IMMONEXT'],
  ['🇬🇳', 'Guinée', 'Représentation structurelle'],
  ['🇨🇲', 'Cameroun', 'Développement actif'],
  ['🇸🇳', 'Sénégal', 'Expansion 2026'],
];
---

<section id="pourquoi" class="relative overflow-hidden bg-slate-50 py-32 dark:bg-[#0c1118]">
  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center reveal-on-scroll">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.25em] text-primary-700 dark:text-accent-300">Pourquoi AG Nexum</p>
      <h2 class="mb-6 text-4xl font-extrabold text-slate-900 dark:text-white md:text-5xl">Quatre raisons de nous choisir.</h2>
    </div>

    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-4 md:grid-cols-2">
      {reasons.map((reason, index) => (
        <details class="group glass-panel rounded-2xl reveal-on-scroll [&_summary::-webkit-details-marker]:hidden" open={index === 0} style={`transition-delay: ${index * 60}ms;`}>
          <summary class="flex cursor-pointer items-center justify-between gap-4 p-6 font-medium text-slate-900 dark:text-white">
            <h3 class="text-lg font-bold">{reason.title}</h3>
            <span class="relative h-5 w-5 shrink-0 text-slate-500 transition-colors group-open:text-primary-700 dark:text-slate-400 dark:group-open:text-accent-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 h-5 w-5 opacity-100 transition-opacity group-open:opacity-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
              <svg xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 h-5 w-5 opacity-0 transition-opacity group-open:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" /></svg>
            </span>
          </summary>
          <div class="px-6 pb-6 leading-relaxed text-slate-600 dark:text-slate-400">
            <p>{reason.text}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<section id="reseau" class="relative overflow-hidden bg-white py-32 dark:bg-[#071522]">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-400/60 to-transparent"></div>
  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center reveal-on-scroll">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.25em] text-primary-700 dark:text-accent-300">Présence & réseau</p>
      <h2 class="mb-6 text-4xl font-extrabold text-slate-900 dark:text-white md:text-5xl">Du Québec vers le monde.</h2>
    </div>

    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 lg:grid-cols-[1.1fr_1.4fr]">
      <article class="glass-panel rounded-3xl p-8 reveal-on-scroll hover-glow">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.22em] text-accent-600 dark:text-accent-300">Siège social</p>
        <h3 class="mb-6 text-3xl font-bold text-slate-900 dark:text-white">Longueuil — Québec</h3>
        <p class="mb-6 text-lg leading-relaxed text-slate-600 dark:text-slate-400">
          771 Rue Dubuisson<br />Longueuil (Québec) J4L 2S8<br />Canada
        </p>
        <p class="rounded-xl border border-primary-100 bg-primary-50 p-4 text-sm font-semibold text-primary-800 dark:border-primary-800/70 dark:bg-primary-950/50 dark:text-accent-200">
          Société de portefeuille canadienne
        </p>
      </article>

      <article class="glass-panel rounded-3xl p-8 reveal-on-scroll hover-glow" style="transition-delay: 100ms;">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.22em] text-accent-600 dark:text-accent-300">Réseau international</p>
        <h3 class="mb-8 text-3xl font-bold text-slate-900 dark:text-white">Représentation structurée par pays</h3>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {network.map(([flag, country, detail]) => (
            <div class="rounded-2xl border border-slate-200/70 bg-white/70 p-5 dark:border-slate-800/70 dark:bg-slate-950/30">
              <div class="mb-3 text-3xl">{flag}</div>
              <h4 class="mb-1 text-lg font-bold text-slate-900 dark:text-white">{country}</h4>
              <p class="text-sm text-slate-600 dark:text-slate-400">{detail}</p>
            </div>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>
