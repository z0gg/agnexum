---
const team = [
  {
    name: 'Anselme Guigui',
    role: 'Président-directeur général · Fondateur',
    bio: "Architecte du groupe et de ses quatre divisions, Anselme Guigui pilote la stratégie corporate, le développement international et les partenariats institutionnels d'AG Nexum. Établi au Québec depuis plus de vingt ans, il combine une formation de spécialiste en médecine et une expertise opérationnelle acquise au sein du Groupe Master, leader nord-américain de la distribution CVAC.",
    initials: 'AG',
    image: '/images/team/anselme-guigui.webp',
  },
  {
    name: 'David Tremblay',
    role: 'Développement & stratégie',
    bio: "Pilote le développement commercial du groupe et coordonne les initiatives stratégiques transversales aux quatre divisions. Supervise l'expansion du portefeuille de partenaires institutionnels.",
    initials: 'DT',
  },
  {
    name: 'Me Catherine Beaulieu',
    role: 'Affaires juridiques & conformité',
    bio: 'Dirige le département juridique. Supervise la conformité réglementaire, la rédaction et la négociation des contrats commerciaux ainsi que les relations avec les ordres professionnels.',
    initials: 'CB',
    image: '/images/team/catherine-beaulieu.webp',
  },
  {
    name: 'Sandrine Mboumba',
    role: 'Gestion des dossiers',
    bio: "Dirige la gestion des dossiers clients pour l'ensemble du groupe. Structure les processus opérationnels et garantit la qualité du suivi de la prise de contact à la clôture du mandat.",
    initials: 'SM',
    image: '/images/team/sandrine-mboumba.webp',
  },
  {
    name: 'Aïcha Diallo',
    role: 'Services francophones',
    bio: "Dirige l'accompagnement client en français, langue principale du groupe. Coordonne les équipes servant les clientèles d'Afrique francophone et du Québec.",
    initials: 'AD',
    image: '/images/team/aicha-diallo.webp',
  },
  {
    name: 'Carlos Mendoza',
    role: 'Services hispanophones',
    bio: 'Pilote le développement des services destinés à la clientèle hispanophone. Focus sur les corridors Amérique latine–Canada.',
    initials: 'CM',
    image: '/images/team/carlos-mendoza.webp',
  },
  {
    name: 'Yasmine Haddad',
    role: 'Services arabophones',
    bio: 'Dirige le service client arabophone et structure le développement du groupe sur les marchés du Maghreb et du Moyen-Orient.',
    initials: 'YH',
    image: '/images/team/yasmine-haddad.webp',
  },
];
---

<section id="equipe" class="relative overflow-hidden bg-white py-32 dark:bg-[#071522]">
  <div class="absolute right-0 top-1/2 h-[500px] w-[500px] -translate-y-1/2 translate-x-1/3 rounded-full bg-primary-500/10 blur-[100px] mix-blend-multiply dark:bg-accent-500/5 dark:mix-blend-screen"></div>

  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-20 max-w-3xl text-center reveal-on-scroll">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.25em] text-primary-700 dark:text-accent-300">Équipe exécutive</p>
      <h2 class="mb-6 text-4xl font-extrabold italic text-primary-900 dark:text-white md:text-5xl">Les têtes de file des départements clés.</h2>
    </div>

    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {team.map((person, index) => (
        <article class="glass-panel group relative flex h-full flex-col rounded-3xl p-8 hover-glow reveal-on-scroll" style={`transition-delay: ${index * 70}ms;`}>
          <div class="absolute right-6 top-6 font-serif text-6xl leading-none text-slate-100 transition-transform duration-500 group-hover:-rotate-12 group-hover:scale-110 dark:text-slate-800/50">“</div>
          {person.image ? (
            <img
              src={person.image}
              alt={`Portrait de ${person.name}`}
              width="640"
              height="640"
              loading="lazy"
              decoding="async"
              class="relative z-10 mb-6 h-24 w-24 rounded-2xl border border-accent-200/70 object-cover shadow-lg shadow-primary-950/10 dark:border-accent-500/30"
            />
          ) : (
            <div class="relative z-10 mb-6 flex h-24 w-24 items-center justify-center rounded-2xl border border-accent-200/70 bg-primary-700 text-xl font-extrabold tracking-wide text-white shadow-lg shadow-primary-950/10 dark:border-accent-500/30 dark:bg-accent-500 dark:text-primary-950">
              {person.initials}
            </div>
          )}
          <h3 class="relative z-10 mb-2 text-2xl font-bold text-slate-900 dark:text-white">{person.name}</h3>
          <p class="relative z-10 mb-5 text-xs font-bold uppercase tracking-[0.18em] text-accent-600 dark:text-accent-300">{person.role}</p>
          <p class="relative z-10 flex-grow leading-relaxed text-slate-600 dark:text-slate-400">{person.bio}</p>
        </article>
      ))}
    </div>
  </div>
</section>
