---
import { FOOTER_LINKS, SITE_DESCRIPTION } from '../config';
import { resolvePath } from '../utils/navigation';
---

<footer class="border-t border-slate-200 bg-white pb-8 pt-16 transition-colors dark:border-primary-800 dark:bg-[#071522]">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-[minmax(280px,1.35fr)_repeat(4,minmax(130px,1fr))] lg:gap-10">
      <div>
        <a href={resolvePath('/')} class="mb-4 inline-flex items-center">
          <span class="leading-none">
            <span class="block text-2xl font-extrabold tracking-wide text-accent-600 dark:text-accent-300">AG NEXUM</span>
            <span class="block text-[0.72rem] font-bold uppercase tracking-[0.44em] text-primary-700 dark:text-white/85">Canada</span>
          </span>
        </a>
        <p class="mb-6 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {SITE_DESCRIPTION}
        </p>
        <p class="rounded-xl border border-primary-100 bg-primary-50 p-4 text-sm text-primary-800 dark:border-primary-800/70 dark:bg-primary-950/50 dark:text-accent-200">
          771 Rue Dubuisson<br />Longueuil, QC J4L 2S8<br />Canada
        </p>
      </div>

      {FOOTER_LINKS.map(group => (
        <div>
          <h3 class="mb-4 font-semibold text-slate-900 dark:text-white">{group.title}</h3>
          <ul class="space-y-3">
            {group.links.map(link => (
              <li>
                <a href={resolvePath(link.href)} class="text-sm text-slate-600 transition-colors hover:text-primary-700 dark:text-slate-400 dark:hover:text-accent-300">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-slate-200 pt-8 dark:border-primary-800 md:flex-row">
      <p class="text-sm text-slate-500 dark:text-slate-400">
        &copy; {new Date().getFullYear()} AGNexum Canada. Tous droits réservés.
      </p>
      <p class="text-sm text-slate-500 dark:text-slate-400">
        Réseau international : Côte d’Ivoire · Guinée · Cameroun · Sénégal
      </p>
    </div>
  </div>
</footer>
