---
import type { Locale } from '../config';

interface Props {
  lang?: Locale;
}

const { lang = 'fr' } = Astro.props;
const data = {
  fr: {
    aboutId: 'a-propos',
    kicker: 'Qui nous sommes',
    title: 'Un holding canadien.',
    titleMuted: 'Quatre divisions opérationnelles.',
    intro: 'AG Nexum Inc. structure et opère un écosystème intégré de services à forte intensité de conformité.',
    cardKicker: 'AG Nexum Inc.',
    cardTitle: 'Société de portefeuille canadienne',
    paragraphs: [
      'Société enregistrée au Registraire des entreprises du Québec. Le groupe structure et opère un écosystème intégré de services à forte intensité de conformité — immigration canadienne, voyage international B2B, recouvrement d’actifs non réclamés et technologies sectorielles.',
      'Notre force tient à une combinaison rare : un siège canadien soumis aux standards les plus exigeants de la province de Québec, des équipes multilingues qualifiées, et un réseau international structuré qui couvre l’Afrique francophone, l’Europe et les Amériques.',
      'Nous opérons dans une logique d’intermédiation stratégique : qualifier, structurer et certifier les flux commerciaux entre les continents francophones.',
    ],
    stats: [
      ['04', 'Divisions opérationnelles'],
      ['11', "Membres de l’équipe exécutive"],
      ['03', 'Langues de service client'],
      ['20+', "Années d’ancrage au Québec"],
    ],
    divisionsKicker: 'Nos divisions',
    divisionsTitle: 'Quatre marques, une seule signature.',
    divisions: [
      {
        title: 'ImmiCan',
        kicker: 'Immigration canadienne',
        summary: 'Génération et qualification de prospects, orientation vers consultants CRCIC.',
        text: 'Plateforme d’évaluation préliminaire et d’orientation pour candidats à l’immigration canadienne. Spécialisation Afrique francophone : Guinée, Côte d’Ivoire, Cameroun, Sénégal. Tous les conseils juridiques en immigration sont rendus par des consultants réglementés membres en règle du Collège des consultants en immigration et en citoyenneté (CRCIC) ou par des avocats canadiens partenaires.',
      },
      {
        title: 'AL Escape-ImmiCan',
        kicker: 'Voyage international B2B',
        summary: "Intermédiation et apport d’affaires aux compagnies aériennes.",
        text: 'Activité strictement B2B d’intermédiation commerciale. AL Escape met en relation et structure des flux de clientèle à destination des compagnies aériennes partenaires opérant sur les corridors Afrique–Europe–Amériques. La division ne vend aucun titre de transport en direct.',
      },
      {
        title: 'AG Nexum Recouvrement',
        kicker: 'Actifs non réclamés',
        summary: 'Récupération d’actifs non réclamés au Québec. Modèle au succès.',
        text: 'Recherche, validation et restitution d’actifs dormants détenus par les institutions financières et les autorités publiques. Modèle de rémunération exclusivement à la contingence : pas de frais en amont, pas de coût pour le bénéficiaire avant restitution effective.',
      },
      {
        title: 'AG HVAC Solutions',
        kicker: 'CVAC & SOLUHVAC',
        summary: 'Lead generation pour entrepreneurs CVAC. Plateforme SOLUHVAC.',
        text: 'Plateforme de génération de prospects qualifiés pour entrepreneurs CVAC au Canada, complétée par SOLUHVAC, une application de gestion opérationnelle destinée aux techniciens indépendants. Intégration verticale : acquisition client, gestion de chantier, facturation.',
      },
    ],
  },
  en: {
    aboutId: 'about',
    kicker: 'Who we are',
    title: 'A Canadian holding company.',
    titleMuted: 'Four operating divisions.',
    intro: 'AG Nexum Inc. structures and operates an integrated ecosystem of compliance-intensive services.',
    cardKicker: 'AG Nexum Inc.',
    cardTitle: 'Canadian holding company',
    paragraphs: [
      'Registered with the Québec enterprise registrar, the group structures and operates an integrated ecosystem of compliance-intensive services — Canadian immigration, B2B international travel, unclaimed-asset recovery and sector-focused technologies.',
      'Our strength comes from a rare combination: a Canadian head office held to Québec’s demanding standards, qualified multilingual teams, and a structured international network covering French-speaking Africa, Europe and the Americas.',
      'We operate as a strategic intermediary: qualifying, structuring and certifying business flows between francophone continents.',
    ],
    stats: [
      ['04', 'Operating divisions'],
      ['11', 'Executive team members'],
      ['03', 'Client service languages'],
      ['20+', 'Years rooted in Québec'],
    ],
    divisionsKicker: 'Our divisions',
    divisionsTitle: 'Four brands, one signature.',
    divisions: [
      {
        title: 'ImmiCan',
        kicker: 'Canadian immigration',
        summary: 'Lead generation and qualification, with orientation to CRCIC consultants.',
        text: 'A preliminary assessment and orientation platform for Canadian immigration candidates. Specialized in French-speaking Africa: Guinea, Côte d’Ivoire, Cameroon and Senegal. All immigration legal advice is provided by regulated consultants in good standing with the College of Immigration and Citizenship Consultants (CICC/CRCIC) or by Canadian partner lawyers.',
      },
      {
        title: 'AL Escape-ImmiCan',
        kicker: 'B2B international travel',
        summary: 'Commercial intermediation and business development for airlines.',
        text: 'A strictly B2B commercial intermediation activity. AL Escape connects and structures customer flows for partner airlines operating across the Africa–Europe–Americas corridors. The division does not sell transportation tickets directly.',
      },
      {
        title: 'AG Nexum Recovery',
        kicker: 'Unclaimed assets',
        summary: 'Recovery of unclaimed assets in Québec. Success-based model.',
        text: 'Search, validation and restitution of dormant assets held by financial institutions and public authorities. Compensation is strictly contingency-based: no upfront fees and no cost to the beneficiary before effective restitution.',
      },
      {
        title: 'AG HVAC Solutions',
        kicker: 'HVAC & SOLUHVAC',
        summary: 'Lead generation for HVAC contractors. SOLUHVAC platform.',
        text: 'A qualified lead-generation platform for HVAC contractors in Canada, complemented by SOLUHVAC, an operations-management app for independent technicians. Vertical integration: client acquisition, job management and invoicing.',
      },
    ],
  },
  es: {
    aboutId: 'acerca-de',
    kicker: 'Quiénes somos',
    title: 'Una sociedad holding canadiense.',
    titleMuted: 'Cuatro divisiones operativas.',
    intro: 'AG Nexum Inc. estructura y opera un ecosistema integrado de servicios con altos estándares de cumplimiento.',
    cardKicker: 'AG Nexum Inc.',
    cardTitle: 'Sociedad holding canadiense',
    paragraphs: [
      'Registrada ante el registro de empresas de Québec, el grupo estructura y opera un ecosistema integrado de servicios con alta exigencia de cumplimiento: inmigración canadiense, viajes internacionales B2B, recuperación de activos no reclamados y tecnologías sectoriales.',
      'Nuestra fortaleza nace de una combinación poco común: una sede canadiense sujeta a los estándares exigentes de Québec, equipos multilingües calificados y una red internacional estructurada que cubre África francófona, Europa y las Américas.',
      'Operamos bajo una lógica de intermediación estratégica: calificar, estructurar y certificar flujos comerciales entre continentes francófonos.',
    ],
    stats: [
      ['04', 'Divisiones operativas'],
      ['11', 'Miembros del equipo ejecutivo'],
      ['03', 'Idiomas de atención al cliente'],
      ['20+', 'Años de presencia en Québec'],
    ],
    divisionsKicker: 'Nuestras divisiones',
    divisionsTitle: 'Cuatro marcas, una sola firma.',
    divisions: [
      {
        title: 'ImmiCan',
        kicker: 'Inmigración canadiense',
        summary: 'Generación y calificación de prospectos, con orientación hacia consultores CRCIC.',
        text: 'Plataforma de evaluación preliminar y orientación para candidatos a la inmigración canadiense. Especialización en África francófona: Guinea, Côte d’Ivoire, Camerún y Senegal. Toda asesoría legal de inmigración es prestada por consultores regulados en regla ante el Colegio de Consultores de Inmigración y Ciudadanía (CICC/CRCIC) o por abogados canadienses aliados.',
      },
      {
        title: 'AL Escape-ImmiCan',
        kicker: 'Viajes internacionales B2B',
        summary: 'Intermediación comercial y desarrollo de negocios para aerolíneas.',
        text: 'Actividad estrictamente B2B de intermediación comercial. AL Escape conecta y estructura flujos de clientes para aerolíneas aliadas que operan en los corredores África–Europa–Américas. La división no vende boletos de transporte directamente.',
      },
      {
        title: 'AG Nexum Recuperación',
        kicker: 'Activos no reclamados',
        summary: 'Recuperación de activos no reclamados en Québec. Modelo basado en el éxito.',
        text: 'Búsqueda, validación y restitución de activos inactivos mantenidos por instituciones financieras y autoridades públicas. La remuneración es exclusivamente contingente: sin costos por adelantado y sin cargos para el beneficiario antes de la restitución efectiva.',
      },
      {
        title: 'AG HVAC Solutions',
        kicker: 'HVAC & SOLUHVAC',
        summary: 'Generación de prospectos para contratistas HVAC. Plataforma SOLUHVAC.',
        text: 'Plataforma de generación de prospectos calificados para contratistas HVAC en Canadá, complementada por SOLUHVAC, una aplicación de gestión operativa para técnicos independientes. Integración vertical: adquisición de clientes, gestión de trabajos y facturación.',
      },
    ],
  },
}[lang];

const icons = [
  '<path d="M12 21s7-4.35 7-11a7 7 0 1 0-14 0c0 6.65 7 11 7 11Z"></path><circle cx="12" cy="10" r="2.5"></circle>',
  '<path d="M17.8 19.2 16 11l3.5-3.5a2.1 2.1 0 0 0-3-3L13 8 4.8 6.2 3.5 7.5 9 12l-4 4v2h2l4-4 4.5 5.5 1.3-1.3Z"></path>',
  '<path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>',
  '<path d="M4 14a8 8 0 1 1 16 0"></path><path d="M18 14a6 6 0 0 0-12 0"></path><path d="M8 14a4 4 0 0 1 8 0"></path><path d="M12 14h.01"></path>',
];
---

<section id={data.aboutId} class="relative overflow-hidden border-y border-slate-200 bg-slate-50 py-32 dark:border-slate-800 dark:bg-[#0c1118]">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-accent-200/30 via-transparent to-transparent dark:from-primary-800/15 dark:via-transparent dark:to-transparent"></div>

  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-20 max-w-4xl text-center reveal-on-scroll">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.25em] text-primary-700 dark:text-accent-300">{data.kicker}</p>
      <h2 class="mb-6 text-4xl font-extrabold text-slate-900 dark:text-white md:text-5xl">
        {data.title} <br /><span class="text-slate-400 dark:text-slate-500">{data.titleMuted}</span>
      </h2>
      <p class="text-xl leading-relaxed text-slate-600 dark:text-slate-400">{data.intro}</p>
    </div>

    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 lg:grid-cols-4 lg:grid-rows-[auto_auto]">
      <div class="glass-panel group relative overflow-hidden rounded-3xl p-8 hover-glow reveal-on-scroll lg:col-span-2 lg:row-span-2">
        <div class="absolute inset-0 bg-gradient-to-br from-primary-500/10 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
        <p class="relative z-10 mb-4 text-sm font-bold uppercase tracking-[0.24em] text-accent-600 dark:text-accent-300">{data.cardKicker}</p>
        <h3 class="relative z-10 mb-6 text-3xl font-bold text-slate-900 dark:text-white">{data.cardTitle}</h3>
        <div class="relative z-10 space-y-5 text-lg leading-relaxed text-slate-600 dark:text-slate-400">
          {data.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        </div>
        <div class="relative z-10 mt-8 rounded-xl border border-primary-800 bg-primary-950 p-4 font-mono text-sm text-accent-200 shadow-2xl">
          <code>{lang === 'es' ? 'Québec → África francófona → Europa → Américas' : lang === 'en' ? 'Québec → French-speaking Africa → Europe → Americas' : 'Québec → Afrique francophone → Europe → Amériques'}</code>
        </div>
      </div>

      {data.stats.map(([value, label], index) => (
        <div class="glass-panel rounded-3xl p-8 text-center hover-glow reveal-on-scroll" style={`transition-delay: ${index * 80}ms;`}>
          <div class="mb-3 text-5xl font-extrabold text-primary-700 dark:text-accent-300">{value}</div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">{label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="divisions" class="relative overflow-hidden bg-white py-32 dark:bg-[#071522]">
  <div class="absolute right-0 top-1/2 h-[540px] w-[540px] -translate-y-1/2 translate-x-1/3 rounded-full bg-primary-500/10 blur-[110px] mix-blend-multiply dark:bg-accent-600/10 dark:mix-blend-screen"></div>
  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-20 max-w-3xl text-center reveal-on-scroll">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.25em] text-primary-700 dark:text-accent-300">{data.divisionsKicker}</p>
      <h2 class="mb-6 text-4xl font-extrabold text-slate-900 dark:text-white md:text-5xl">{data.divisionsTitle}</h2>
    </div>

    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 md:grid-cols-2">
      {data.divisions.map((division, index) => (
        <article class="glass-panel group flex min-h-[360px] flex-col rounded-3xl p-8 hover-glow reveal-on-scroll" style={`transition-delay: ${index * 90}ms;`}>
          <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-100 text-primary-700 shadow-inner transition-transform duration-300 group-hover:scale-105 dark:bg-primary-900/50 dark:text-accent-300" set:html={`<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icons[index]}</svg>`} />
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-accent-600 dark:text-accent-300">{division.kicker}</p>
          <h3 class="mb-3 text-2xl font-bold text-slate-900 dark:text-white">{division.title}</h3>
          <p class="mb-5 font-semibold leading-relaxed text-primary-700 dark:text-accent-200">{division.summary}</p>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">{division.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
