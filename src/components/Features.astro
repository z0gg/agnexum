---
import type { Locale } from '../config';

interface Props {
  lang?: Locale;
}

const { lang = 'fr' } = Astro.props;

const palettes = ['#1b6fa8', '#7b4a9e', '#b8263a', '#2e7d5b', '#d4580a', '#0d6e8a', '#445e7a'];

const data = {
