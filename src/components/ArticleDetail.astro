---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Article, ArticleContent } from '../data/articles';
import type { Locale } from '../config';
import { resolvePath } from '../utils/navigation';

interface Props {
  article: Article;
  content: ArticleContent;
  lang: Locale;
}

const { article, content, lang } = Astro.props;
const contactHref = lang === 'fr' ? '/#contact' : lang === 'en' ? '/en/#contact' : '/es/#contacto';
const resourcesHref = lang === 'fr' ? '/#ressources' : lang === 'en' ? '/en/#resources' : '/es/#recursos';
const backLabel = lang === 'fr' ? 'Retour aux ressources' : lang === 'en' ? 'Back to resources' : 'Volver a recursos';
const sourceLabel = lang === 'fr' ? 'Sources vérifiées' : lang === 'en' ? 'Verified sources' : 'Fuentes verificadas';
const updatedLabel = lang === 'fr' ? 'Mis à jour' : lang === 'en' ? 'Updated' : 'Actualizado';
---

<BaseLayout
  title={content.title}
  description={content.description}
  type="article"
  publishedDate={new Date(article.publishedDate)}
  modifiedDate={new Date(article.modifiedDate)}
  author="AG Nexum Canada"
  lang={lang}
>
  <article class="bg-white dark:bg-[#071522]">
    <header class="relative isolate overflow-hidden bg-slate-950 py-24 text-white sm:py-28">
      <div class="absolute inset-0 opacity-95" style={`background: radial-gradient(circle at top left, ${article.color} 0%, transparent 34%), linear-gradient(135deg, #071522 0%, #0f2a47 52%, ${article.color} 140%);`}></div>
      <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
      <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
        <a href={resolvePath(resourcesHref)} class="mb-10 inline-flex items-center rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-bold text-white/85 backdrop-blur transition hover:bg-white/20 hover:text-white">
          ← {backLabel}
        </a>
        <div class="max-w-4xl">
          <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-extrabold uppercase tracking-[0.22em] text-white/80">
            {content.eyebrow}
          </p>
          <h1 class="text-4xl font-extrabold leading-tight tracking-tight md:text-6xl">{content.title}</h1>
          <p class="mt-6 max-w-3xl text-xl leading-relaxed text-white/78">{content.description}</p>
          <div class="mt-8 flex flex-wrap gap-3 text-sm font-bold text-white/80">
            <span class="rounded-full bg-white/10 px-4 py-2">{content.division}</span>
            <span class="rounded-full bg-white/10 px-4 py-2">{content.readTime}</span>
            <span class="rounded-full bg-white/10 px-4 py-2">{updatedLabel} · {article.modifiedDate}</span>
          </div>
        </div>
      </div>
    </header>

    <div class="container mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:px-8">
      <div class="min-w-0">
        <section class="mb-12 grid grid-cols-1 gap-4 md:grid-cols-3">
          {content.highlights.map((highlight) => (
            <div class="rounded-2xl border p-5 shadow-sm" style={`border-color: ${article.color}33; background: linear-gradient(180deg, ${article.accent}, #ffffff);`}>
              <div class="mb-3 h-1.5 w-14 rounded-full" style={`background-color: ${article.color};`}></div>
              <p class="font-bold leading-snug text-slate-900">{highlight}</p>
            </div>
          ))}
        </section>

        <div class="prose prose-slate max-w-none dark:prose-invert prose-headings:font-extrabold prose-h2:text-3xl prose-p:text-lg prose-p:leading-relaxed">
          {content.sections.map((section) => (
            <section class="mb-12">
              <h2>{section.title}</h2>
              {section.body.map((paragraph) => <p>{paragraph}</p>)}
            </section>
          ))}
        </div>

        <section class="mt-16 rounded-3xl border border-slate-200 bg-slate-50 p-6 dark:border-primary-800 dark:bg-primary-950/40 sm:p-8">
          <p class="mb-4 text-sm font-extrabold uppercase tracking-[0.22em] text-primary-700 dark:text-accent-300">{sourceLabel}</p>
          <h2 class="mb-4 text-3xl font-extrabold text-slate-900 dark:text-white">{content.sourceIntro}</h2>
          <div class="grid gap-4">
            {article.sources.map((source, index) => (
              <a href={source.url} target="_blank" rel="noopener noreferrer" class="group rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-lg dark:border-primary-800 dark:bg-[#071522]">
                <div class="mb-2 flex flex-wrap items-center gap-2 text-xs font-extrabold uppercase tracking-[0.18em]">
                  <span class="rounded-full px-3 py-1 text-white" style={`background-color: ${article.color};`}>Source {index + 1}</span>
                  <span class="text-slate-500 dark:text-slate-400">{source.type}</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 transition group-hover:text-primary-700 dark:text-white dark:group-hover:text-accent-300">{source.label}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{source.note}</p>
              </a>
            ))}
          </div>
        </section>
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-900/5 dark:border-primary-800 dark:bg-[#0c1118]">
          <p class="text-sm font-extrabold uppercase tracking-[0.2em]" style={`color: ${article.color};`}>{content.category}</p>
          <h2 class="mt-3 text-2xl font-extrabold text-slate-900 dark:text-white">{content.ctaTitle}</h2>
          <p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-400">{content.ctaText}</p>
          <a href={resolvePath(contactHref)} class="mt-6 inline-flex w-full items-center justify-center rounded-xl px-5 py-3 font-bold text-white shadow-lg transition hover:opacity-90" style={`background-color: ${article.color};`}>
            {content.ctaLabel}
          </a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
