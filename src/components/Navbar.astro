---
import Button from './Button.astro';
import { LANGUAGE_ROUTES, LOCALES, type Locale } from '../config';
import { resolvePath } from '../utils/navigation';

interface Props {
  lang?: Locale;
}

const { lang = 'fr' } = Astro.props;
const copy = LOCALES[lang];
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const routeAlternates = LANGUAGE_ROUTES[currentPath as keyof typeof LANGUAGE_ROUTES] ?? LANGUAGE_ROUTES['/'];
const languageLinks = (Object.entries(LOCALES) as [Locale, typeof LOCALES[Locale]][])
  .filter(([locale]) => locale !== lang)
  .map(([locale, localeCopy]) => ({
    href: routeAlternates[locale],
    label: localeCopy.label,
    shortLabel: localeCopy.shortLabel,
  }));
const contactHref = copy.nav[copy.nav.length - 1]?.href ?? copy.path;
const topNotice = {
  fr: 'Société enregistrée au Registraire des entreprises du Québec · NEQ 2267508507 · No conseils juridiques en immigration rendus hors cadre CRCIC/Barreau',
  en: 'Registered with the Québec enterprise registrar · NEQ 2267508507 · No immigration legal advice outside the CRCIC/Bar framework',
  es: 'Sociedad registrada ante el registro de empresas de Québec · NEQ 2267508507 · Sin asesoría legal migratoria fuera del marco CRCIC/Colegio de abogados',
}[lang];
---

<header class="sticky top-0 z-[90] w-full rounded-none border-x-0 border-t-0 border-slate-200/70 bg-white/90 shadow-sm backdrop-blur-xl transition-colors duration-300 dark:border-primary-800/60 dark:bg-primary-950/90">
  <div class="hidden border-b border-primary-900/20 bg-primary-950 text-white md:block">
    <div class="container mx-auto flex items-center justify-between gap-4 px-4 py-2 text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-white/80 sm:px-6 lg:px-8">
      <span>{topNotice}</span>
      <span class="whitespace-nowrap text-accent-200">438-543-0363 · info@agnexum.ca</span>
    </div>
  </div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex-shrink-0">
        <a href={resolvePath(copy.path)} class="group flex items-center">
          <span class="leading-none">
            <span class="block text-xl font-extrabold tracking-wide text-accent-600 transition-colors dark:text-accent-300">AG NEXUM</span>
            <span class="block text-[0.68rem] font-bold uppercase tracking-[0.42em] text-primary-700 dark:text-white/85">Canada</span>
          </span>
        </a>
      </div>

      <nav class="hidden items-center gap-8 md:flex">
        {copy.nav.map(link => (
          <a href={resolvePath(link.href)} class="text-sm font-medium text-slate-600 transition-colors hover:text-primary-700 dark:text-slate-300 dark:hover:text-accent-300">
            {link.label}
          </a>
        ))}
      </nav>

      <div class="hidden items-center gap-3 md:flex">
        <div class="flex items-center gap-1.5">
          {languageLinks.map(link => (
            <a href={resolvePath(link.href)} class="rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-bold uppercase tracking-[0.12em] text-slate-600 transition hover:border-accent-400 hover:text-primary-700 dark:border-primary-800 dark:text-slate-300 dark:hover:border-accent-500 dark:hover:text-accent-300">
              {link.label}
            </a>
          ))}
        </div>
        <button id="theme-toggle" data-theme-toggle type="button" class="rounded-lg p-2 text-slate-500 transition-colors hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-accent-500 dark:text-slate-400 dark:hover:bg-primary-900" aria-label={copy.ui.themeToggle}>
          <svg data-theme-dark-icon class="hidden h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
          <svg data-theme-light-icon class="hidden h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
        </button>
        <Button href={contactHref} variant="primary" size="sm">{copy.ui.cta}</Button>
      </div>

      <div class="flex items-center gap-2 md:hidden">
        {languageLinks.map(link => (
          <a href={resolvePath(link.href)} class="rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-bold uppercase text-slate-600 dark:border-primary-800 dark:text-slate-300">
            {link.shortLabel}
          </a>
        ))}
        <button id="mobile-theme-toggle" data-theme-toggle type="button" class="rounded-lg p-2 text-slate-500 transition-colors hover:bg-slate-100 focus:outline-none dark:text-slate-400 dark:hover:bg-primary-900" aria-label={copy.ui.themeToggle}>
          <svg data-theme-dark-icon class="hidden h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
          <svg data-theme-light-icon class="hidden h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
        </button>

        <button id="mobile-menu-btn" class="rounded-md p-2 text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 focus:outline-none dark:text-slate-300 dark:hover:bg-primary-900 dark:hover:text-white">
          <span class="sr-only">{copy.ui.openMenu}</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white md:hidden dark:border-primary-800 dark:bg-primary-950">
    <div class="space-y-1 px-2 pb-3 pt-2 sm:px-3">
      {copy.nav.map(link => (
        <a href={resolvePath(link.href)} class="block rounded-md px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-50 hover:text-primary-700 dark:text-slate-300 dark:hover:bg-primary-900 dark:hover:text-accent-300">
          {link.label}
        </a>
      ))}
      <div class="mt-4 border-t border-slate-200 pt-4 dark:border-primary-800">
        <Button href={contactHref} variant="primary" class="w-full text-center">{copy.ui.cta}</Button>
      </div>
    </div>
  </div>
</header>

<script>
  function setupTheme() {
    const storedTheme = localStorage.getItem('theme');
    if (storedTheme === 'dark' || storedTheme === 'light') {
      document.documentElement.classList.toggle('dark', storedTheme === 'dark');
    }

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        button.setAttribute('aria-pressed', String(isDark));
        button.querySelector('[data-theme-dark-icon]')?.classList.toggle('hidden', isDark);
        button.querySelector('[data-theme-light-icon]')?.classList.toggle('hidden', !isDark);
      });
    }

    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons();
    }

    updateIcons();

    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      if (button.dataset.themeBound === 'true') return;
      button.dataset.themeBound = 'true';
      button.addEventListener('click', toggleTheme);
    });
  }

  function setupMobileMenu() {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuBtn && mobileMenu) {
      const newBtn = mobileMenuBtn.cloneNode(true);
      mobileMenuBtn.parentNode?.replaceChild(newBtn, mobileMenuBtn);
      newBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  }

  setupTheme();
  setupMobileMenu();
  document.addEventListener('astro:page-load', () => {
    setupTheme();
    setupMobileMenu();
  });
</script>
